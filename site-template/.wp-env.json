{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "port": __PORT__,
  "testsPort": __TESTS_PORT__,
  "themes": [
    "../../Tuk DS/tulip/themes/tulip",
    "./__CHILD__"
  ],
  "plugins": [
    "https://downloads.wordpress.org/plugin/create-block-theme.latest-stable.zip"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local",
    "WP_DEVELOPMENT_MODE": "theme"
  },
  "lifecycleScripts": {
    "afterStart": "npx wp-env run cli wp theme activate __CHILD__ && npx wp-env run cli wp language core install ca es_ES"
  },
  "mappings": {
    "wp-content/uploads": "./.pull/uploads",
    "wp-content/pull-db": "./.pull/db"
  }
}
