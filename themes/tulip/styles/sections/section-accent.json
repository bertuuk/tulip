{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Accent",
	"slug": "section-accent",
	"blockTypes": [ "core/group", "core/columns", "core/column" ],
	"styles": {
		"color": {
			"background": "var:preset|color|accent",
			"text": "var:preset|color|on-accent"
		},
		"elements": {
			"heading": { "color": { "text": "var:preset|color|on-accent" } },
			"link": {
				"color": { "text": "var:preset|color|on-accent" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|on-accent",
					"text": "var:preset|color|accent"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|on-accent",
						"text": "var:preset|color|accent"
					},
					"typography": { "textDecoration": "underline" }
				}
			},
			"caption": { "color": { "text": "var:preset|color|on-accent" } }
		}
	}
}
