{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Brand dark",
	"slug": "section-dark",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|brand-strong",
			"text": "var:preset|color|base"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary-light"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|base"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|brand-strong"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-light",
						"text": "var:preset|color|brand-strong"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|primary-light"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|base"
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|base"
						}
					}
				}
			}
		}
	}
}
